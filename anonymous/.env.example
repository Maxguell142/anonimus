# Copiá este archivo a .env y completá los valores.

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=

# Modelo primario y de respaldo si el primario no responde
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=20

# Servidor Web GUI
ANONYMOUS_HOST=127.0.0.1
ANONYMOUS_PORT=7860

# AgentShield
ANONYMOUS_SAFE_MODE=true

# Kali MCP opcional (Docker). Por defecto usa el checkout hermano kali-mcp-main.
KALI_MCP_ROOT=C:\Users\maxgu\Documents\anonimus\kali-mcp-main
KALI_MCP_URL=http://127.0.0.1:666/mcp
